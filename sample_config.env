# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

# Metadata Cache (optional)
# METADATA_CACHE_DIR="/app/cache/metadata"
# METADATA_CACHE_SIZE_MB="10240"
# METADATA_CACHE_TTL_DAYS="7"
# METADATA_NEGATIVE_CACHE_TTL="3600"
# Metadata RAM Cache (optional in-memory L1 cache size and TTL; disk cache acts as persistent L2)
# METADATA_RAM_CACHE_SIZE="64"
# METADATA_RAM_CACHE_TTL="300"

# Thumbnail Cache (optional)
# THUMB_CACHE_DIR="/app/cache/thumbs"
# THUMB_CACHE_SIZE_MB="2048"

# Scan Pipeline (optional)
# SCAN_BATCH_SIZE="200"
# SCAN_PROCESS_CONCURRENCY="8"

# Memory Watchdog (optional threshold to trigger background memory trim, e.g. "800", "1024", "1gb"; 0 to disable)
# MEM_WATCHDOG_MB="1024"

# Docker Resource Limits (optional, used by docker-compose)
# MEM_LIMIT="1g"
# MEM_RESERVATION="512m"

